# newpoint-phi (PHI zone) — variable NAMES only. Never commit values.
# DO NOT FILL until every §2 BAA is signed (Supabase, Trigger.dev HIPAA add-on, Twilio,
# Anthropic HIPAA org). Local development uses test numbers and synthetic data only.
#
# The PHI runtime REFUSES TO START if any public-zone variable is present
# (MARKETING_*, SUPABASE_MARKETING*, ANTHROPIC_API_KEY[_PUBLIC], GSC_*, META_*, GBP_*,
# N8N_SOCIAL_/GBP_/OPS_*, SUPABASE_SERVICE_*, SUPABASE_SECRET*). See src/lib/env-phi.ts.

# --- Read by trigger.phi.config.ts (CLI only)
TRIGGER_PROJECT_REF_PHI=

# --- Task runtime
PHI_DATABASE_URL=
PHI_DATABASE_CA_CERT=
SUPABASE_PHI_PROJECT_REF=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM=
ANTHROPIC_API_KEY_PHI=
PHI_ON_CALL_PRIMARY_PHONE=
PHI_ON_CALL_SECONDARY_PHONE=
PHI_OPS_PAGE_PHONE=
PHI_STAFF_CONSOLE_URL=
PHI_N8N_ACTION_WEBHOOK_URL=
PHI_N8N_ACTION_WEBHOOK_SECRET=
# Optional, defaults 300 and 4
SMS_DAILY_BUDGET=
SMS_PER_NUMBER_DAILY=

# --- Staff console (D7: host not chosen; src/console/env.ts)
PHI_CONSOLE_DATABASE_URL=
PHI_CONSOLE_JWKS_URL=
PHI_CONSOLE_JWT_ISSUER=
PHI_CONSOLE_JWT_AUDIENCE=
PHI_CONSOLE_SESSION_SECRET=
PHI_CONSOLE_ORIGIN=

# --- Edge handlers (Phase 6; D5: host not confirmed in Supabase's BAA; edge/README.md)
PHI_EDGE_DATABASE_URL=
PHI_TRIGGER_SECRET_KEY=
PHI_TWILIO_INBOUND_URL=
PHI_TURNSTILE_SECRET_KEY=
PHI_INTAKE_HMAC_SECRET=
PHI_SITE_ORIGIN=
# TWILIO_AUTH_TOKEN (above) also signs inbound webhooks.

# --- The SITE (Vercel project newpoint), not this package. Leave BOTH unset until go-live:
# NEXT_PUBLIC_INTAKE_URL=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Voice (Phase 8; Vapi BAA; D4/D13/D15/D21) — edge/vapi-tools, edge/vapi-events, assistant config
PHI_VAPI_API_KEY=
PHI_VAPI_SERVER_SECRET=
PHI_VAPI_ASSISTANT_ID=
PHI_VAPI_TOOLS_URL=
PHI_VAPI_EVENTS_URL=
# D4: Vapi's HIPAA-covered model, transcriber and voice, confirmed in writing with Vapi
PHI_VAPI_MODEL_PROVIDER=
PHI_VAPI_MODEL=
PHI_VAPI_TRANSCRIBER_PROVIDER=
PHI_VAPI_VOICE_PROVIDER=
PHI_VAPI_VOICE_ID=
# D15: the crisis transfer destination, E.164, chosen by the clinicians
PHI_VAPI_CRISIS_TRANSFER_NUMBER=

# --- Reviews and metrics (Phase 9)
# The practice's generic Google review link (needs the verified GBP, D11)
PHI_GOOGLE_REVIEW_URL=
# The insert-only metrics_writer login on newpoint-marketing (all three or none)
PHI_METRICS_WRITER_DATABASE_URL=
PHI_METRICS_WRITER_CA_CERT=
PHI_METRICS_MARKETING_PROJECT_REF=
