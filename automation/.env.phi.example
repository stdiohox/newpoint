# newpoint-phi (PHI zone) — variable NAMES only. Never commit values.
# DO NOT FILL until every §2 BAA is signed (Supabase, Trigger.dev HIPAA add-on, Twilio,
# Anthropic HIPAA org). Local development uses test numbers and synthetic data only.
#
# The PHI runtime REFUSES TO START if any public-zone variable is present
# (MARKETING_*, SUPABASE_MARKETING*, ANTHROPIC_API_KEY[_PUBLIC], GSC_*, META_*, GBP_*,
# N8N_SOCIAL_/GBP_/OPS_*, SUPABASE_SERVICE_*, SUPABASE_SECRET*). See src/lib/env-phi.ts.

# --- Read by trigger.phi.config.ts (CLI only)
TRIGGER_PROJECT_REF_PHI=

# --- Task runtime
PHI_DATABASE_URL=
PHI_DATABASE_CA_CERT=
SUPABASE_PHI_PROJECT_REF=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_FROM=
ANTHROPIC_API_KEY_PHI=
PHI_ON_CALL_PRIMARY_PHONE=
PHI_ON_CALL_SECONDARY_PHONE=
PHI_OPS_PAGE_PHONE=
PHI_STAFF_CONSOLE_URL=
PHI_N8N_ACTION_WEBHOOK_URL=
PHI_N8N_ACTION_WEBHOOK_SECRET=
# Optional, defaults 300 and 4
SMS_DAILY_BUDGET=
SMS_PER_NUMBER_DAILY=

# --- Staff console (D7: host not chosen; src/console/env.ts)
PHI_CONSOLE_DATABASE_URL=
PHI_CONSOLE_JWKS_URL=
PHI_CONSOLE_JWT_ISSUER=
PHI_CONSOLE_JWT_AUDIENCE=
PHI_CONSOLE_SESSION_SECRET=
PHI_CONSOLE_ORIGIN=
