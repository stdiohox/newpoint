{
  "name": "newpoint-automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Newpoint automation layer. See docs/automation-architecture.md.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run test/db",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:marketing": "trigger dev --config trigger.marketing.config.ts --env-file .env.marketing",
    "deploy:marketing": "trigger deploy --config trigger.marketing.config.ts --env-file .env.marketing",
    "db:push:marketing": "npx --yes supabase@2.120.0 db push --workdir supabase/marketing --db-url \"$MARKETING_ADMIN_DB_URL\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@trigger.dev/sdk": "4.7.3",
    "google-auth-library": "11.1.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "trigger.dev": "4.7.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "@embedded-postgres/darwin-x64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-arm64@17.10.0-beta.17": true,
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
