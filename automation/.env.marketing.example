# newpoint-marketing (PUBLIC zone) — variable NAMES only. Never commit values.
# Runtime values live in the Trigger.dev dashboard for the newpoint-marketing
# project; copy this file to .env.marketing for local `npm run dev:marketing`.
#
# The marketing runtime REFUSES TO START if any PHI-zone variable is present
# (anything matching *_PHI*, TWILIO_*, VAPI_*, SUPABASE_SERVICE_ROLE*, or an
# unqualified ANTHROPIC_API_KEY). See src/lib/env.ts.

# --- Read by trigger.marketing.config.ts (CLI / CI only, not the task runtime)
# Project ref from Trigger.dev → newpoint-marketing → Project settings (proj_…)
TRIGGER_PROJECT_REF_MARKETING=
# CI deploys only: a Trigger.dev personal access token (tr_pat_…)
TRIGGER_ACCESS_TOKEN=

# --- Read by the task runtime (src/lib/env.ts → loadMarketingEnv)
# Session-pooler URL for the `trigger_marketing` login (member of marketing_rw):
# postgresql://trigger_marketing.<project-ref>:<password>@<pooler-host>:5432/postgres
MARKETING_DATABASE_URL=
# Supabase → Database settings → SSL configuration → Download certificate. The PEM text,
# newlines as-is (the Trigger.dev dashboard accepts multi-line values).
MARKETING_DATABASE_CA_CERT=
# Supabase → newpoint-marketing → Project settings → Project ID (20 lowercase letters).
# MARKETING_DATABASE_URL must point at this project or the runtime refuses to start.
SUPABASE_MARKETING_PROJECT_REF=
# Anthropic STANDARD (public) org key, sk-ant-… — never the HIPAA org's key.
ANTHROPIC_API_KEY_PUBLIC=
# Search Console property: sc-domain:newpointnp.com  (or https://newpointnp.com/)
GSC_SITE_URL=
# Full JSON key of the gsc-reader service account, on one line
GSC_SERVICE_ACCOUNT_JSON=
# Optional. The public site geo.recommendations reads for schema.org coverage.
# Defaults to https://newpointnp.com/ ; point it at the rebuilt site's URL before launch if useful.
GEO_SITE_URL=

# --- Phase 3, social (§5.7). Optional until social goes live.
# Graph API version pinned by hand, e.g. v24.0 (check Meta's changelog; never left to default).
META_GRAPH_VERSION=
# Facebook Page ID and a long-lived Page access token (after Meta app review).
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram professional account ID linked to the Page. Leave empty to skip Instagram.
META_IG_USER_ID=
# n8n approval webhook (n8n/workflows/social-approval.json) and its Header Auth secret (32+ chars).
N8N_SOCIAL_APPROVAL_WEBHOOK_URL=
N8N_SOCIAL_APPROVAL_WEBHOOK_SECRET=

# --- Phase 4, GBP (§5.2). Optional until GBP goes live.
# OAuth client (Google Cloud → APIs & Services → Credentials) and a refresh token of a
# user who is an owner or manager of the listing, with scope business.manage.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
# Numeric ids from the GBP Account Management / Business Information APIs.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# Leave unset until D11 (legal name, address, storefront vs service area) is confirmed.
GBP_NAP_AUDIT_ENABLED=
# n8n: review-reply approval (raw review beside the draft) and Koret ops alerts.
N8N_GBP_REPLY_APPROVAL_WEBHOOK_URL=
N8N_GBP_REPLY_APPROVAL_WEBHOOK_SECRET=
N8N_OPS_ALERT_WEBHOOK_URL=
N8N_OPS_ALERT_WEBHOOK_SECRET=
