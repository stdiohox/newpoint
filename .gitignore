# macOS
.DS_Store

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
next-env.d.ts

# Vercel
.vercel

# Env
.env
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Stray media dropped in the repo root (keep public/video/ tracked)
/*.mp4
/*.mov

# Stray source art dropped in the repo root. The masters live outside the repo
# and only their webp derivatives under public/images/ are committed, so a JPEG
# or PNG at the root is always a copy that slipped in — twice it has been one
# `git add -A` away from being committed.
/*.png
/*.jpg
/*.jpeg

# Pre-encode masters. The web-sized derivatives under public/video/ are what
# ship; these stay local so the repo never carries two copies of every clip.
/media-src/

# Before/after boards for the provider portrait enhancement. Review artefacts,
# multi-megabyte PNGs, and regenerable from the sources in assets/providers/.
/design-research/enhanced-preview/

# Design source art. Untouched originals and intermediate exports for the
# homepage sections, tens of MB and consumed only by the one-off resize/cutout
# steps. Everything the site actually serves is committed under public/.
# The README.md files in here stay tracked so the folders explain themselves.
design-research/assets/
!design-research/assets/**/README.md
